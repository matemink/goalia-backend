  "cards": [
    {
      "dot": "cyan",
      "title": "Request-time refresh",
      "items": [
        "Fresh cache avoids an upstream refresh unless force_refresh is set.",
        "Missing token or failed refresh retains cached data when available."
      ]
    },
    {
      "dot": "emerald",
      "title": "Prediction ownership",
      "items": [
        "The disk file stores raw upstream matches.",
        "Enrichment runs on each response; unknown team or league IDs omit prediction."
      ]
    },
    {
      "dot": "slate",
      "title": "Runtime shape",
      "items": [
        "Cache state is process-local; the fallback is a JSON file.",
        "CatBoost model and mapping files are loaded at import time."
      ]
